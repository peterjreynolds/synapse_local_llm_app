rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function hasActiveAccountClaims() {
      return signedIn()
        && request.auth.token.accountState == 'ACTIVE'
        && request.auth.token.mustChangePassword == false
        && request.auth.token.role in ['OWNER', 'ADMIN', 'USER'];
    }

    function isActiveUser() {
      return hasActiveAccountClaims()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.allowed == true
        && get(profilePath(request.auth.uid)).data.accountState == 'ACTIVE'
        && get(profilePath(request.auth.uid)).data.mustChangePassword == false
        && get(profilePath(request.auth.uid)).data.role == request.auth.token.role;
    }

    function isActiveRoomMember(roomId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      return isActiveUser()
        && exists(memberPath)
        && get(memberPath).data.active == true;
    }

    function validProfilePresentation(profile) {
      return profile.displayName is string
        && profile.displayName.size() >= 1
        && profile.displayName.size() <= 64
        && profile.bio is string
        && profile.bio.size() <= 160
        && (profile.avatarUrl == null || (profile.avatarUrl is string && profile.avatarUrl.size() <= 2048));
    }

    function validHumanMessage(messageId) {
      let message = request.resource.data;
      return message.keys().hasOnly([
          'authorKind',
          'body',
          'clientCreatedAt',
          'clientMessageId',
          'createdAt',
          'deletedAt',
          'editedAt',
          'replyToMessageId',
          'senderUid'
        ])
        && message.authorKind == 'HUMAN'
        && message.senderUid == request.auth.uid
        && message.clientMessageId == messageId
        && message.body is string
        && message.body.size() >= 1
        && message.body.size() <= 4000
        && message.clientCreatedAt is timestamp
        && message.createdAt == request.time
        && message.editedAt == null
        && message.deletedAt == null
        && (message.replyToMessageId == null || message.replyToMessageId is string);
    }

    match /profiles/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid)
        || (isActiveUser()
          && resource.data.allowed == true
          && resource.data.accountState == 'ACTIVE'
          && resource.data.directoryVisible == true);
      allow list: if isActiveUser()
        && resource.data.allowed == true
        && resource.data.accountState == 'ACTIVE'
        && resource.data.directoryVisible == true;
      allow create, delete: if false;
      allow update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'avatarUrl',
          'bio',
          'displayName',
          'lastSeenAt',
          'online',
          'updatedAt'
        ])
        && validProfilePresentation(request.resource.data)
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.online is bool;
    }

    match /usernames/{normalizedUsername} {
      allow read, write: if false;
    }

    match /blocks/{blockId} {
      allow read, write: if false;
    }

    match /accountDeletionRequests/{uid} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow get, list: if isActiveUser()
        && request.auth.uid in resource.data.activeMemberIds;
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if isActiveRoomMember(roomId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isActiveRoomMember(roomId);
        allow create: if isActiveRoomMember(roomId) && validHumanMessage(messageId);
        allow update, delete: if false;

        match /reactions/{reactionId} {
          allow read, write: if false;
        }

        match /receipts/{uid} {
          allow read, write: if false;
        }
      }

      match /typing/{uid} {
        allow read: if isActiveRoomMember(roomId);
        allow create, update: if isActiveRoomMember(roomId)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['expiresAt', 'uid', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(15, 's');
        allow delete: if isActiveRoomMember(roomId) && request.auth.uid == uid;
      }
    }

    match /messageMutationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /devices/{deviceId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
