rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isActiveUser() {
      return request.auth != null
        && request.auth.token.accountState == 'ACTIVE'
        && request.auth.token.mustChangePassword == false
        && request.auth.token.role in ['OWNER', 'ADMIN', 'USER']
        && firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.allowed == true
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.accountState == 'ACTIVE'
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.mustChangePassword == false
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == request.auth.token.role;
    }

    function isVisibleProfile(uid) {
      return firestore.exists(/databases/(default)/documents/profiles/$(uid))
        && firestore.get(/databases/(default)/documents/profiles/$(uid)).data.allowed == true
        && firestore.get(/databases/(default)/documents/profiles/$(uid)).data.accountState == 'ACTIVE'
        && firestore.get(/databases/(default)/documents/profiles/$(uid)).data.directoryVisible == true;
    }

    function isActiveRoomMember(roomId) {
      let membershipPath = /databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      return isActiveUser()
        && firestore.exists(membershipPath)
        && firestore.get(membershipPath).data.active == true;
    }

    function isGroupAdministrator(roomId) {
      let membershipPath = /databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      return isActiveRoomMember(roomId)
        && firestore.get(membershipPath).data.role in ['OWNER', 'ADMIN'];
    }

    match /avatars/{uid}/{fileName} {
      allow read: if isActiveUser() && isVisibleProfile(uid);
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && fileName.matches('avatar\\.(jpg|jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isActiveUser() && request.auth.uid == uid;
    }

    match /groupAvatars/{roomId}/{fileName} {
      allow read: if isActiveRoomMember(roomId);
      allow create, update: if isGroupAdministrator(roomId)
        && roomId.matches('group_[a-f0-9]{32}')
        && fileName.matches('avatar_[a-f0-9]{32}\\.(jpg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isGroupAdministrator(roomId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
