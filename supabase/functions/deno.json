{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.112.3",
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check redeem-invite/index.ts sign-in/index.ts register-device/index.ts issue-invite/index.ts redeem-room-invite/index.ts purge-expired-data/index.ts",
    "test": "deno test tests"
  }
}
